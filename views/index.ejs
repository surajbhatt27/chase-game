<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <style>
        :root {
            --board-light: #ebdcc4;
            --board-dark: #a97c5b;
            --ink: #f1f5f9;
        }

        body {
            margin: 0;
            font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
            -webkit-tap-highlight-color: transparent;
        }

        /* ---- Board ------------------------------------------------------- */

        .board-frame {
            padding: clamp(6px, 1.4vw, 12px);
            border-radius: 18px;
            background: linear-gradient(150deg, #2a3341, #141920 70%);
            box-shadow: 0 26px 60px -24px rgba(0, 0, 0, 0.9), inset 0 1px 0 rgba(255, 255, 255, 0.07);
        }

        .chessboard {
            display: grid;
            grid-template-columns: repeat(8, 1fr);
            grid-template-rows: repeat(8, 1fr);
            width: min(560px, 92vw, 74vh);
            aspect-ratio: 1 / 1;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.35);
        }

        .square {
            display: flex;
            align-items: center;
            justify-content: center;
            user-select: none;
            position: relative;
            touch-action: manipulation;
            cursor: pointer;
        }

        .square.light { background-color: var(--board-light); }

        .square.dark { background-color: var(--board-dark); }

        @media (hover: hover) {
            .square:hover { box-shadow: inset 0 0 0 3px rgba(255, 255, 255, 0.28); }
        }

        .square.last-move { box-shadow: inset 0 0 0 4px rgba(255, 213, 79, 0.65); }

        .square.selected { box-shadow: inset 0 0 0 4px rgba(56, 189, 248, 0.9); }

        /* Where the selected piece can go (the server sends the destinations). */
        .square.legal::after {
            content: "";
            position: absolute;
            top: 50%;
            left: 50%;
            width: 28%;
            height: 28%;
            transform: translate(-50%, -50%);
            border-radius: 50%;
            background-color: rgba(20, 20, 20, 0.32);
            pointer-events: none;
        }

        /* A destination holding a piece is a capture: ring it instead of dotting it. */
        .square.legal-capture::after {
            width: 84%;
            height: 84%;
            background-color: transparent;
            border: 4px solid rgba(20, 20, 20, 0.32);
        }

        .piece {
            font-size: clamp(26px, 7vw, 44px);
            line-height: 1;
            filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.35));
            pointer-events: auto;
        }

        .piece[draggable="true"] { cursor: grab; }
        .piece[draggable="true"]:active { cursor: grabbing; }

        .piece.white {
            color: #ffffff;
            -webkit-text-stroke: 1.5px #2b2b2b;
        }

        .piece.black {
            color: #1b1b1b;
            -webkit-text-stroke: 1px #000000;
        }

        .flipped { transform: rotate(180deg); }

        .flipped .piece { transform: rotate(180deg); }

        /* ---- Sidebar ----------------------------------------------------- */

        .card {
            border-radius: 16px;
            padding: 16px;
            background: rgba(39, 39, 42, 0.62);
            border: 1px solid rgba(255, 255, 255, 0.06);
            backdrop-filter: blur(8px);
        }

        .card-title {
            font-size: 11px;
            letter-spacing: 0.09em;
            text-transform: uppercase;
            color: #94a3b8;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .status {
            font-weight: 650;
            font-size: 15px;
            line-height: 1.35;
            margin-bottom: 12px;
            transition: color 0.15s ease;
        }

        .meta-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            font-size: 13px;
            color: #cbd5e1;
        }

        .meta-row + .meta-row { margin-top: 6px; }

        .meta-value {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-weight: 600;
            color: var(--ink);
        }

        .role-pill {
            padding: 1px 8px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.08);
            font-size: 12px;
            color: var(--ink);
        }

        .turn-dot {
            width: 10px;
            height: 10px;
            border-radius: 999px;
            border: 1px solid #94a3b8;
            display: inline-block;
        }

        #seatLine {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 12px;
            font-size: 11px;
        }

        .seat {
            padding: 2px 8px;
            border-radius: 999px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #94a3b8;
        }

        .seat.connected { color: #6ee7b7; border-color: rgba(110, 231, 183, 0.4); }
        .seat.reserved { color: #fcd34d; border-color: rgba(252, 211, 77, 0.4); }

        .move-list {
            max-height: min(300px, 32vh);
            overflow-y: auto;
            font-size: 13px;
            font-variant-numeric: tabular-nums;
            scrollbar-width: thin;
        }

        .move-list > div {
            display: grid;
            grid-template-columns: 2.2rem 1fr 1fr;
            gap: 4px;
            padding: 3px 6px;
            border-radius: 6px;
            color: var(--ink);
        }

        .move-list > div:nth-child(even) { background: rgba(255, 255, 255, 0.04); }

        .move-list .move-no { color: #7f8ea3; font-weight: 600; }

        .btn {
            flex: 1;
            padding: 9px 14px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            border: 1px solid transparent;
            transition: transform 0.12s ease, background-color 0.15s ease, opacity 0.15s ease;
        }

        .btn:active:not(:disabled) { transform: scale(0.98); }

        .btn-primary { background: #059669; color: #ecfdf5; }
        .btn-primary:hover:not(:disabled) { background: #10b981; }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.07);
            color: var(--ink);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .btn-secondary:hover:not(:disabled) { background: rgba(255, 255, 255, 0.12); }

        .btn:focus-visible { outline: 2px solid #38bdf8; outline-offset: 2px; }

        button:disabled {
            opacity: 0.45;
            cursor: not-allowed;
        }

        /* ---- Promotion overlay ------------------------------------------- */

        #promotion {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        #promotion.hidden { display: none; }

        #promotion .promo-card {
            border-radius: 18px;
            padding: 18px;
            text-align: center;
            background: linear-gradient(160deg, #262e3a, #131820);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 26px 60px -20px rgba(0, 0, 0, 0.95);
        }

        #promotion .promo-title {
            font-size: 11px;
            letter-spacing: 0.09em;
            text-transform: uppercase;
            color: #94a3b8;
            font-weight: 600;
            margin-bottom: 12px;
        }

        #promotion button {
            width: 62px;
            height: 62px;
            font-size: 38px;
            line-height: 1;
            padding: 0;
            border-radius: 12px;
            background: var(--board-light);
            color: #14181f;
            border: 1px solid #c9b296;
            cursor: pointer;
            transition: transform 0.12s ease, background-color 0.15s ease;
        }

        #promotion button:hover {
            background: #f7efdd;
            transform: translateY(-2px);
        }

        #promotion button:focus-visible { outline: 2px solid #38bdf8; outline-offset: 2px; }
    </style>
</head>
<body class="min-h-screen bg-gradient-to-br from-slate-950 via-zinc-900 to-slate-900 text-slate-100 antialiased p-4 sm:p-6">
    <div class="w-full max-w-5xl mx-auto flex flex-col gap-4 sm:gap-6">
        <header class="flex items-baseline justify-between gap-4">
            <h1 class="text-lg font-semibold tracking-tight">Chess</h1>
            <span class="text-xs text-slate-500">Drag a piece, or tap it and tap where it goes</span>
        </header>

        <div class="grid grid-cols-1 gap-4 sm:gap-6 lg:grid-cols-3 lg:items-start">
            <div class="lg:col-span-2 flex justify-center">
                <div class="board-frame">
                    <div class="chessboard"></div>
                </div>
            </div>

            <div class="lg:col-span-1 flex flex-col gap-4">
                <div class="card">
                    <div class="status" id="status">Connecting…</div>

                    <div class="meta-row">
                        <span>You are</span>
                        <span class="meta-value"><span class="role-pill" id="myRole">Spectator</span></span>
                    </div>

                    <div class="meta-row">
                        <span>To move</span>
                        <span class="meta-value"><span class="turn-dot" id="turnDot"></span><span id="turnText">—</span></span>
                    </div>

                    <div id="seatLine"></div>
                </div>

                <div class="card">
                    <div class="card-title">Move history</div>
                    <div class="move-list" id="moveList"></div>
                </div>

                <div class="card flex gap-2">
                    <button id="resetBtn" class="btn btn-primary">New Game</button>
                    <button id="flipBtn" class="btn btn-secondary">Flip View</button>
                </div>
            </div>
        </div>
    </div>

    <div id="promotion" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm">
        <div class="promo-card">
            <div class="promo-title">Promote pawn to</div>
            <div class="flex gap-2">
                <button type="button" data-piece="q">♛</button>
                <button type="button" data-piece="r">♜</button>
                <button type="button" data-piece="b">♝</button>
                <button type="button" data-piece="n">♞</button>
            </div>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/chessgame.js"></script>
</body>
</html>
