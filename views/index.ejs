<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <style>
        body {
            margin: 0;
            font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
        }

        .chessboard {
            display: grid;
            grid-template-columns: repeat(8, 1fr);
            grid-template-rows: repeat(8, 1fr);
            width: min(440px, 92vw);
            aspect-ratio: 1 / 1;
            border-radius: 8px;
            overflow: hidden;
        }

        .square {
            display: flex;
            align-items: center;
            justify-content: center;
            user-select: none;
            position: relative;
            touch-action: manipulation;
        }

        .square.light { background-color: #f0d9b5; }

        .square.dark { background-color: #b58863; }

        .square.last-move { box-shadow: inset 0 0 0 4px rgba(255, 213, 79, 0.65); }

        .square.selected { box-shadow: inset 0 0 0 4px rgba(56, 189, 248, 0.9); }

        .piece {
            font-size: clamp(24px, 6vw, 38px);
            line-height: 1;
            cursor: grab;
        }

        .piece[draggable="true"] { cursor: grab; }
        .piece[draggable="true"]:active { cursor: grabbing; }

        .piece.white {
            color: #ffffff;
            -webkit-text-stroke: 1.5px #2b2b2b;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
        }

        .piece.black {
            color: #1b1b1b;
            -webkit-text-stroke: 1px #000000;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
        }

        .flipped { transform: rotate(180deg); }

        .flipped .piece { transform: rotate(180deg); }

        .move-list {
            max-height: 320px;
            overflow-y: auto;
            padding: 8px;
            font-size: 14px;
            font-variant-numeric: tabular-nums;
            background: rgba(255, 255, 255, 0.02);
            border-radius: 6px;
        }

        .status {
            font-weight: 600;
            margin-bottom: 6px;
        }

        .turn-dot {
            width: 10px;
            height: 10px;
            border-radius: 999px;
            border: 1px solid #94a3b8;
            display: inline-block;
            margin-right: 6px;
            vertical-align: middle;
        }

        button:disabled {
            opacity: 0.45;
            cursor: not-allowed;
        }

        #promotion {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        #promotion.hidden { display: none; }

        #promotion button {
            font-size: 32px;
            line-height: 1;
            padding: 8px 12px;
            border-radius: 8px;
            background: #f0d9b5;
            color: #1b1b1b;
            border: 1px solid #b58863;
        }

        #promotion button:hover { background: #e6c9a0; }
    </style>
</head>
<body class="bg-zinc-900 text-slate-100 min-h-screen flex items-center justify-center p-6">
    <div class="w-full max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="md:col-span-2 flex items-center justify-center">
            <div class="chessboard"></div>
        </div>

        <div class="md:col-span-1 space-y-4">
            <div class="p-4 bg-zinc-800 rounded-lg shadow-inner">
                <div class="status" id="status">Connecting…</div>
                <div class="text-sm mb-2">You are: <span id="myRole">Spectator</span></div>
                <div class="text-sm">Turn: <span><span class="turn-dot" id="turnDot"></span><span id="turnText">—</span></span></div>
                <div class="text-xs text-slate-400 mt-2" id="seatLine">White: empty · Black: empty</div>
            </div>

            <div class="p-4 bg-zinc-800 rounded-lg">
                <div class="text-sm font-semibold mb-2">Move History</div>
                <div class="move-list" id="moveList"></div>
            </div>

            <div class="p-4 bg-zinc-800 rounded-lg flex gap-2">
                <button id="resetBtn" class="px-3 py-2 bg-emerald-600 rounded hover:opacity-90">New Game</button>
                <button id="flipBtn" class="px-3 py-2 bg-sky-600 rounded hover:opacity-90">Flip View</button>
            </div>
        </div>
    </div>

    <div id="promotion" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm">
        <div class="bg-zinc-800 rounded-lg p-4 text-center">
            <div class="text-sm font-semibold mb-2">Promote pawn to</div>
            <div class="flex gap-2">
                <button type="button" data-piece="q">♛</button>
                <button type="button" data-piece="r">♜</button>
                <button type="button" data-piece="b">♝</button>
                <button type="button" data-piece="n">♞</button>
            </div>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/chessgame.js"></script>
</body>
</html>
